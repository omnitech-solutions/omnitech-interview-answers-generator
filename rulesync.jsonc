{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "targets": {
    "agentsskills": { "skills": true },
    "claudecode": {
      "rules": true,
      "commands": true,
      "skills": true,
      "ignore": { "fileMode": "local" },
    },
    "codexcli": {
      "rules": true,
      "skills": true,
    },
    "cursor": {
      "rules": true,
      "commands": true,
      "skills": true,
    },
    "opencode": {
      "rules": true,
      "commands": true,
      "skills": true,
    },
  },
  "outputRoots": ["."],
  "delete": true,
  "simulateCommands": true,
  "simulateSkills": true,
  "gitignoreTargetsOnly": true,
}
