{
  "name": "@omnitech/platform-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai-config": {
      "types": "./dist/ai-config.d.ts",
      "import": "./dist/ai-config.js"
    },
    "./ai-log": {
      "types": "./dist/ai-log.d.ts",
      "import": "./dist/ai-log.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "biome lint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.package.config.ts"
  },
  "dependencies": {
    "@omnitech/ai-engine": "0.1.0",
    "@omnitech/logging": "workspace:*",
    "@omnitech/platform-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
