{
  "name": "@omnitech/platform-storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/platform.d.ts",
      "import": "./dist/schema/platform.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "db:bootstrap": "tsx src/bootstrap.ts",
    "db:migrate": "tsx src/migrate.ts",
    "lint": "biome lint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.package.config.ts"
  },
  "dependencies": {
    "@omnitech-assistant/storage-postgres": "file:../../vendor/omnitech-assistant/omnitech-assistant-storage-postgres-0.1.0.tgz",
    "@omnitech/agent-job-service": "workspace:*",
    "@omnitech/agent-runtime-contracts": "workspace:*",
    "@omnitech/database": "workspace:*",
    "@omnitech/platform-contracts": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "^8.16.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.15.5",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
