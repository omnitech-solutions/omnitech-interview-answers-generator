# Any OpenAI-compatible /v1 endpoint works (OpenAI, LM Studio, Ollama proxy, etc.).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5-mini

# Optional Anthropic API model for platform AI targets (default model
# claude-sonnet-4-6). Unset disables the target.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# LM Studio bearer token, when its server requires one (default: none).
# LM_STUDIO_API_KEY=

# Optional named providers used by the Concept Lab dropdown.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# LM_STUDIO_MODEL=your-loaded-model-id
# LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Optional Studio assistant default through your Claude Code CLI login.
# This does not configure the HTTP model used by generated answers or Active Session.
# INTERVIEW_ASSISTANT_DEFAULT_MODEL=agent/claude-code
# CLAUDE_ASSISTANT_MODEL=claude-sonnet-5-5
# AI_DEFAULT_PROVIDER_ID=openai
# Declared locality per model: device, private-network or remote (default).
# `device` counts only when the base URL is loopback; it is never inferred.
# AI_LOCALITY=remote
# OPENAI_LOCALITY=remote
# LM_STUDIO_LOCALITY=device
TOGETHER_AI_API_KEY=
TOGETHER_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell-Free
FAL_API_KEY=
FAL_IMAGE_MODEL=fal-ai/flux-pro/v1.1-ultra
OPENAI_IMAGE_MODEL=gpt-image-1
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_IMAGE_MODEL=z_image_turbo_bf16.safetensors
# JSON workflow submitted to ComfyUI; use {{prompt}} where text is injected.
# COMFYUI_WORKFLOW_JSON=
AI_PROVIDER_ID=default
AI_PROVIDER_LABEL=Default
AI_TIMEOUT_MS=120000

# Deterministic local development alternative:
# AI_BASE_URL=http://127.0.0.1:3000/api/fake/v1
# AI_MODEL=fake-interview-model

# Terminal gateway (apps/terminal-gateway): port, shared token, the web origins
# it accepts (comma separated; unset allows none) and the platform it calls.
# TERMINAL_GATEWAY_PORT=3001
# TERMINAL_GATEWAY_TOKEN=
# TERMINAL_GATEWAY_ALLOWED_ORIGINS=http://127.0.0.1:3000
# PLATFORM_HTTP_URL=http://127.0.0.1:3000

# Used by CLI clients. The web playground is same-origin and local-only.
INTERVIEW_API_TOKEN=change-me
INTERVIEW_API_URL=http://127.0.0.1:3000
INTERVIEW_DATA_DIR=.data

# Shared platform database. `pnpm dev` starts it with Docker Compose
# (compose.yaml).
DATABASE_URL=postgresql://omnitech:omnitech@127.0.0.1:54320/omnitech

# Shared by the web app and the local agent worker.
AGENT_PAYLOAD_SECRET=replace-with-at-least-32-random-characters

# Auth.js login providers. Login grants are not reused by product integrations.
AUTH_SECRET=replace-with-at-least-32-random-characters
FAKE_AUTH_ENABLED=true
NEXT_PUBLIC_FAKE_AUTH_ENABLED=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=

# Separate OAuth clients for user-authorized product actions.
INTEGRATION_STATE_SECRET=replace-with-at-least-32-random-characters
CONNECTED_ACCOUNT_SECRET=replace-with-at-least-32-random-characters
INTEGRATION_GOOGLE_ID=
INTEGRATION_GOOGLE_SECRET=
INTEGRATION_LINKEDIN_ID=
INTEGRATION_LINKEDIN_SECRET=

# Active Session (read by apps/agent-worker, which must run for sessions to work).
# docker lets the coding path run tests in the Docker runner; unset means no
# tests ever run.
# ACTIVE_SESSION_CODE_RUNNER=docker
# true declares the Docker runner runs on this device, so a device-only
# session may run tests.
# ACTIVE_SESSION_RUNNER_DEVICE_LOCAL=true
# on lets a validated coding task escalate to a bounded agent job.
# ACTIVE_SESSION_AGENT_ESCALATION=on

# Active Session agent port (read by apps/agent-worker). `on` serves the
# tool-less session agent profiles through the worker; anything else keeps them
# off. ACTIVE_SESSION_AGENT_PROFILE pins which runtime answers (claude or
# codex). ACTIVE_SESSION_AGENT_MAX_TURNS bounds a session answer's turns
# (integer, at least 6, default 6). ACTIVE_SESSION_AGENT_STAGING_DIR is the
# private directory attachments are staged in (default: a per-process folder
# under the system temp directory).
# ACTIVE_SESSION_AGENT_PORT=on
# ACTIVE_SESSION_AGENT_PROFILE=claude
# ACTIVE_SESSION_AGENT_MAX_TURNS=6
# ACTIVE_SESSION_AGENT_STAGING_DIR=

# Real-provider integration check (`pnpm test:integration`): names the agent
# runtime signed in on this machine, claude-code or codex. Unset skips it, and
# the script refuses to run without it. It sends a fixed, non-private prompt.
# ACTIVE_SESSION_AGENT_INTEGRATION=claude-code

# Agent model selection (read by packages/ai-runtime, used by the web app and
# the worker). Defaults are the model ids in packages/ai-runtime/src/config.ts.
# CLAUDE_DOCUMENT_MODEL=claude-opus-4-6
# CLAUDE_FALLBACK_MODEL=
# CODEX_FAST_MODEL=gpt-5.3-codex
# CODEX_QUALITY_MODEL=gpt-5.3-codex
# CODEX_ASSISTANT_MODEL=gpt-5.3-codex
# Codex CLI binary for the worker (default: `codex` found on PATH, else the
# SDK's bundled binary).
# CODEX_PATH=

# First tenant and owner that `pnpm dev` and the bootstrap script seed.
# PLATFORM_BOOTSTRAP_EMAIL=local@omnitech.test
# PLATFORM_BOOTSTRAP_TENANT=local
# PLATFORM_BOOTSTRAP_TENANT_NAME=Local Workspace

# Local seeds for the owner's default profile and document templates (outside
# production only). Defaults are the studio folder's own data.
# INTERVIEW_DEFAULT_MATRIX_PATH=
# INTERVIEW_TEMPLATES_DIR=

# On-device (WebGPU) model. ON_DEVICE_MODEL_DIR serves the packed files at
# /model (unset answers 404). The browser checks every file against the pinned
# manifest digest; the URL defaults to /model/manifest.json.
# ON_DEVICE_MODEL_DIR=
# NEXT_PUBLIC_ON_DEVICE_MODEL_SHA256=
# NEXT_PUBLIC_ON_DEVICE_MODEL_URL=/model/manifest.json

# Build: where Next writes its output (default .next), and the build id shown in
# the app. The id is set by next.config.ts from the git commit; do not set it.
# NEXT_DIST_DIR=.next
# NEXT_PUBLIC_BUILD_ID=

# LM Studio load settings used by `pnpm dev`: the model's idle TTL in seconds
# (default 14400).
# ASSISTANT_MODEL_TTL_SECONDS=14400

# Maintainer scripts. OMNITECH_ASSISTANT_SRC points scripts/assistant-sync.mjs
# at the omnitech-assistant checkout (default: a sibling directory).
# BENCHMARK_LIVE=1 allows the live-provider benchmarks under
# packages/agent-runtime-*/scripts and scripts/benchmark-document-groups.ts,
# which may use BENCHMARK_CLAUDE_MODEL (default sonnet) and BENCHMARK_CODEX_MODEL
# (default gpt-6-luna).
# OMNITECH_ASSISTANT_SRC=
# BENCHMARK_LIVE=1
# BENCHMARK_CLAUDE_MODEL=sonnet
# BENCHMARK_CODEX_MODEL=gpt-6-luna

# Browser end-to-end suite (`pnpm test:browser`, e2e/live-session; never part of
# `pnpm verify`). It needs Docker and the Playwright browsers
# (`pnpm test:browser:install`). All optional:
# E2E_HEADED=1 shows the browser; E2E_STRICT=1 makes claims still marked
# `pending` in e2e/live-session/src/claims/claims.ts fail the run;
# E2E_REBUILD=1 forces a fresh `next build` (otherwise the build is reused while
# the source is unchanged); E2E_BROWSER_CHANNEL=chrome runs the Chromium project
# in the installed Google Chrome instead of Playwright's Chromium.
# E2E_DIST_DIR names the web build directory (default .next-e2e; it must start
# with .next-e2e and hold no path separator) so parallel runs do not share one.
# E2E_LIVE=1 prints a wall-clock START/END line per test (project, file:line,
# title) so a screen recording can be matched to the running test.
# E2E_SHARDS is how many parallel shards run the whole suite (default 4, at
# most 8; 1 runs one process). Each shard has its own stack: PostgreSQL
# container, ports, worker and storage state. Naming spec files, --shard, --list,
# --ui or --debug runs one process. E2E_SHARD is set per shard by the runner;
# never set it.
# E2E_STACK_CONFIG is set by the suite's global setup for its workers; never set it.
# E2E_HEADED=1
# E2E_STRICT=1
# E2E_REBUILD=1
# E2E_LIVE=1
E2E_SHARDS=4
# E2E_BROWSER_CHANNEL=chrome
# E2E_DIST_DIR=.next-e2e
# E2E_STACK_CONFIG=

# Documentation tooling (Crux). derive-arch ignores a repository's own arch
# extractor unless this is 1, and then regenerates bionic/arch/data-model.md as a
# stub, which shows as false drift. This repository's extractor is
# tools/crux/arch/drizzle_data_model.py (wired in .bionic.yml), so the default is
# on. Only `pnpm docs:arch` and `pnpm docs:arch:check` read it from here or the
# environment (default 1); Crux's own scripts do not read .env. For a raw
# derive-arch, audit-docs or check-drift run, prefix that one command with
# CRUX_ARCH_ALLOW_OVERRIDES=1 and never export it in a shell profile: it lets
# Crux run repository Python, so a profile export does that in every repository.
CRUX_ARCH_ALLOW_OVERRIDES=1
# CRUX_PLUGIN_ROOT is the installed Crux plugin directory (default: the newest
# version under ~/.claude/plugins/cache/crux/crux).
# CRUX_PLUGIN_ROOT=
