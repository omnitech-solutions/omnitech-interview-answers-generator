{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "incremental": true,
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "types": ["node"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "references": [
    { "path": "../../packages/ai-sdk" },
    { "path": "../../packages/interview-contracts" },
    { "path": "../../packages/interview-library" },
    { "path": "../../packages/interview-storage" },
    { "path": "../../packages/code-runner" }
  ],
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
