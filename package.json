{
  "name": "omnitech-interview-answers-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev.mjs",
    "terminal:dev": "pnpm --filter @omnitech/terminal-gateway dev",
    "terminal:build": "pnpm --filter @omnitech/terminal-gateway build",
    "format": "biome format . --error-on-warnings",
    "format:write": "biome format . --write",
    "lint": "biome lint .",
    "lint:swift": "node scripts/swiftlint.mjs",
    "format:swift": "node scripts/swift-format.mjs",
    "format:swift:write": "node scripts/swift-format.mjs --write",
    "lint:fix": "biome lint . --write",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "vitest run --coverage",
    "test:no-docker": "vitest run --project node --project react",
    "test:browser": "pnpm --filter @omnitech/e2e-live-session run test:browser",
    "test:browser:install": "pnpm --filter @omnitech/e2e-live-session run test:browser:install",
    "test:integration": "ACTIVE_SESSION_AGENT_INTEGRATION=${ACTIVE_SESSION_AGENT_INTEGRATION:?set it to claude-code or codex (a runtime signed in on this machine)} vitest run --project integration",
    "verify:core": "pnpm lint && pnpm format && pnpm typecheck && pnpm test:coverage && pnpm build && node scripts/verify-native.mjs",
    "verify": "pnpm verify:core && pnpm test:browser",
    "runner:build": "docker build -t omnitech/rspec-runner:latest packages/code-runner/docker/rspec && docker build -t omnitech/pest-runner:latest packages/code-runner/docker/pest && docker build -t omnitech/vitest-runner:latest packages/code-runner/docker/vitest",
    "cli": "pnpm --filter @omnitech/interview-answers-cli dev",
    "cli:build": "pnpm --filter @omnitech/interview-answers-cli build",
    "cli:install:global": "pnpm cli:build && cd packages/interview-cli && pnpm --ignore-workspace link --global",
    "cli:uninstall:global": "pnpm remove --global @omnitech/interview-answers-cli",
    "hooks:install": "lefthook install",
    "hooks:run:pre-commit": "lefthook run pre-commit",
    "hooks:run:pre-push": "lefthook run pre-push",
    "prepare": "lefthook install",
    "dev:stop": "node scripts/dev-stop.mjs",
    "library:devdocs": "node scripts/import-devdocs.mjs",
    "app:up": "docker compose --profile app up -d --build && scripts/docker-host-services.sh start",
    "app:dev": "scripts/app-dev.sh",
    "app:down": "scripts/docker-host-services.sh stop; docker compose --profile app down",
    "knip": "knip --no-exit-code",
    "docs:arch": "node scripts/docs-arch.mjs",
    "docs:arch:check": "node scripts/docs-arch.mjs --dry-run",
    "coach:listen": "pnpm --filter @omnitech/agent-worker exec tsx src/coach-listen.ts",
    "coach:replay": "pnpm --filter @omnitech/agent-worker exec tsx src/coach-replay.ts",
    "engine:sync": "pnpm --dir ../omnitech-ai-engine --filter @omnitech/ai-engine build && pnpm --dir ../omnitech-ai-engine/packages/ai-engine pack --pack-destination \"$PWD/vendor/omnitech-ai-engine\" && pnpm install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@vitest/coverage-v8": "^4.1.10",
    "knip": "^6.40.0",
    "lefthook": "^2.1.10",
    "turbo": "^2.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  },
  "pnpm": {
    "overrides": {
      "@omnitech-assistant/contracts": "file:vendor/omnitech-assistant/omnitech-assistant-contracts-0.1.0.tgz",
      "@omnitech-assistant/providers": "file:vendor/omnitech-assistant/omnitech-assistant-providers-0.1.0.tgz",
      "@omnitech-assistant/server": "file:vendor/omnitech-assistant/omnitech-assistant-server-0.1.0.tgz",
      "@omnitech-assistant/storage-postgres": "file:vendor/omnitech-assistant/omnitech-assistant-storage-postgres-0.1.0.tgz",
      "@omnitech-assistant/sdk": "file:vendor/omnitech-assistant/omnitech-assistant-sdk-0.1.0.tgz",
      "@omnitech-assistant/react": "file:vendor/omnitech-assistant/omnitech-assistant-react-0.1.0.tgz",
      "@oc-tech/omni-ui-components": "file:vendor/omni-ui-components/oc-tech-omni-ui-components-0.1.0.tgz",
      "@omnitech-assistant/provider-on-device": "file:vendor/omnitech-assistant/omnitech-assistant-provider-on-device-0.1.0.tgz",
      "@omnitech/local-assistant": "file:vendor/omnitech-on-device-llm/omnitech-local-assistant-0.1.0.tgz",
      "@omnitech/local-inference": "file:vendor/omnitech-on-device-llm/omnitech-local-inference-0.1.0.tgz",
      "@omnitech/ai-engine": "file:vendor/omnitech-ai-engine/omnitech-ai-engine-0.1.0.tgz"
    }
  }
}
