{
  "name": "omnitech-interview-answers-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --parallel --filter @omnitech/interview-web --filter @omnitech/terminal-gateway run dev",
    "terminal:dev": "pnpm --filter @omnitech/terminal-gateway dev",
    "terminal:build": "pnpm --filter @omnitech/terminal-gateway build",
    "format": "biome format . --error-on-warnings",
    "format:write": "biome format . --write",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm lint && pnpm format && pnpm typecheck && pnpm test:coverage && pnpm build",
    "runner:build": "docker build -t omnitech/rspec-runner:latest packages/code-runner/docker/rspec && docker build -t omnitech/pest-runner:latest packages/code-runner/docker/pest && docker build -t omnitech/vitest-runner:latest packages/code-runner/docker/vitest",
    "cli": "pnpm --filter @omnitech/interview-answers-cli dev",
    "cli:build": "pnpm --filter @omnitech/interview-answers-cli build",
    "cli:install:global": "pnpm cli:build && cd packages/interview-cli && pnpm --ignore-workspace link --global",
    "cli:uninstall:global": "pnpm remove --global @omnitech/interview-answers-cli",
    "rulesync:generate": "rulesync generate && pnpm --filter @omnitech/interview-rulesync-codex build && pnpm --filter @omnitech/interview-rulesync-codex generate",
    "rulesync:verify": "pnpm --filter @omnitech/interview-rulesync-codex build && pnpm --filter @omnitech/interview-rulesync-codex verify",
    "hooks:install": "lefthook install",
    "hooks:run:pre-commit": "lefthook run pre-commit",
    "hooks:run:pre-push": "lefthook run pre-push",
    "prepare": "lefthook install",
    "assistant:dev": "node scripts/assistant-dev.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@vitest/coverage-v8": "^4.1.10",
    "lefthook": "^2.1.10",
    "rulesync": "^9.6.2",
    "turbo": "^2.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  },
  "pnpm": {
    "overrides": {
      "@omni-assistant/contracts": "file:vendor/omni-assistant/omni-assistant-contracts-0.1.0.tgz",
      "@omni-assistant/providers": "file:vendor/omni-assistant/omni-assistant-providers-0.1.0.tgz",
      "@omni-assistant/server": "file:vendor/omni-assistant/omni-assistant-server-0.1.0.tgz",
      "@omni-assistant/storage-postgres": "file:vendor/omni-assistant/omni-assistant-storage-postgres-0.1.0.tgz",
      "@omni-assistant/sdk": "file:vendor/omni-assistant/omni-assistant-sdk-0.1.0.tgz",
      "@omni-assistant/react": "file:vendor/omni-assistant/omni-assistant-react-0.1.0.tgz"
    }
  }
}
