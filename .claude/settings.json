{
  "permissions": {
    "deny": [
      "Read(.data/)",
      "Read(.next/)",
      "Read(dist/)",
      "Read(node_modules/)"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/format-edited.mjs\""
          }
        ]
      }
    ]
  }
}
