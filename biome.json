{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "includes": [
      "**/*.{js,jsx,ts,tsx,json,jsonc}",
      "!**/node_modules",
      "!**/.next",
      "!**/.next-e2e*",
      "!**/.playwright-report",
      "!**/.test-results",
      "!apps/web/public/ocr",
      "!.swiftlint.baseline.json",
      "!e2e/live-session/.stack",
      "!e2e/live-session/.audit",
      "!**/.data",
      "!.dev-local",
      "!**/dist",
      "!**/.turbo",
      "!**/.build",
      "!**/.build-cov",
      "!coverage",
      "!packages/database/drizzle",
      "!bionic",
      "!.claude/worktrees"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUndeclaredDependencies": "error",
        "noPrivateImports": "error",
        "useYield": "error",
        "noUnsafeOptionalChaining": "error",
        "noEmptyPattern": "warn",
        "noEmptyCharacterClassInRegex": "warn",
        "noUnusedVariables": "warn",
        "noUnusedFunctionParameters": "warn"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["next", "next/*"],
                "message": "Domain code never imports Next.js (AGENTS.md rule 3, INV-0008): only apps/web may."
              }
            ]
          }
        },
        "noNonNullAssertion": "off",
        "useImportType": "warn",
        "useTemplate": "warn",
        "useConst": "warn"
      },
      "a11y": {
        "useSemanticElements": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "useFocusableInteractive": "warn",
        "noStaticElementInteractions": "warn",
        "useKeyWithClickEvents": "warn",
        "noNoninteractiveTabindex": "warn",
        "useAriaPropsForRole": "warn",
        "noAriaHiddenOnFocusable": "warn",
        "noRedundantRoles": "warn",
        "noNoninteractiveElementToInteractiveRole": "warn",
        "useMediaCaption": "warn"
      },
      "suspicious": {
        "noAssignInExpressions": "warn",
        "useIterableCallbackReturn": "warn",
        "noShadowRestrictedNames": "warn",
        "noImplicitAnyLet": "warn",
        "noExportsInTest": "warn",
        "noExplicitAny": "warn",
        "noUndeclaredEnvVars": {
          "level": "warn",
          "options": {
            "allowedEnvVars": [
              "ACTIVE_SESSION_AGENT_INTEGRATION",
              "AGENT_SERVICE_TOKEN",
              "AI_ENGINE_CAPTURE",
              "AI_ENGINE_DATABASE_URL",
              "ANTHROPIC_API_KEY",
              "ANTHROPIC_MODEL",
              "ASSISTANT_CONTEXT_TOKENS",
              "AUTH_ASSUME_LOOPBACK_CLIENTS",
              "AUTH_GOOGLE_ID",
              "AUTH_GOOGLE_SECRET",
              "AUTH_LINKEDIN_ID",
              "AUTH_LINKEDIN_SECRET",
              "AUTH_URL",
              "BENCHMARK_CLAUDE_MODEL",
              "BENCHMARK_CODEX_MODEL",
              "BENCHMARK_LIVE",
              "BUILD_PACKAGED",
              "CODEX_HOME",
              "CODEX_PATH",
              "CODE_RUNNER_PORT",
              "CODE_RUNNER_TOKEN",
              "COMFYUI_BASE_URL",
              "COMFYUI_IMAGE_MODEL",
              "COMFYUI_WORKFLOW_JSON",
              "CONNECTED_ACCOUNT_SECRET",
              "DATABASE_OWNER_URL",
              "DATABASE_URL",
              "E2E_BROWSER_CHANNEL",
              "E2E_HEADED",
              "E2E_LIVE",
              "E2E_REBUILD",
              "E2E_STRICT",
              "E2E_WALKTHROUGH",
              "E2E_WALKTHROUGH_DIR",
              "FAKE_AUTH_ENABLED",
              "FAL_API_KEY",
              "FAL_IMAGE_MODEL",
              "INTEGRATION_LINKEDIN_PKCE",
              "INTEGRATION_STATE_SECRET",
              "INTERVIEW_API_TOKEN",
              "INTERVIEW_API_URL",
              "INTERVIEW_ASSISTANT_DEFAULT_MODEL",
              "INTERVIEW_DATA_DIR",
              "INTERVIEW_DEFAULT_MATRIX_PATH",
              "INTERVIEW_EXPERIENCE_MATRIX_PATH",
              "INTERVIEW_TEMPLATES_DIR",
              "LM_STUDIO_BASE_URL",
              "LM_STUDIO_LOCALITY",
              "LM_STUDIO_MODEL",
              "NEXTAUTH_URL",
              "NEXT_DIST_DIR",
              "NEXT_RUNTIME",
              "NO_COLOR",
              "ON_DEVICE_MODEL_DIR",
              "OPENAI_API_KEY",
              "OPENAI_BASE_URL",
              "OPENAI_IMAGE_MODEL",
              "OPENROUTER_API_KEY",
              "PLATFORM_BOOTSTRAP_EMAIL",
              "PLATFORM_BOOTSTRAP_TENANT",
              "PLATFORM_BOOTSTRAP_TENANT_NAME",
              "PLATFORM_HTTP_URL",
              "TARGET",
              "TERMINAL_GATEWAY_ALLOWED_ORIGINS",
              "TERMINAL_GATEWAY_PORT",
              "TERMINAL_GATEWAY_TOKEN",
              "TOGETHER_AI_API_KEY",
              "TOGETHER_IMAGE_MODEL",
              "TRIALS"
            ]
          }
        },
        "noConfusingVoidType": "warn",
        "noTemplateCurlyInString": "warn",
        "noUselessEscapeInString": "warn",
        "noControlCharactersInRegex": "error",
        "noArrayIndexKey": "warn"
      },
      "complexity": {
        "useOptionalChain": "warn",
        "noCommaOperator": "warn",
        "useRegexLiterals": "warn",
        "noBannedTypes": "warn",
        "noUselessEscapeInRegex": "warn",
        "noUselessFragments": "warn",
        "useLiteralKeys": "off"
      },
      "performance": {
        "noAccumulatingSpread": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["products/*/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["next", "next/*"],
                    "message": "Domain code never imports Next.js (AGENTS.md rule 3, INV-0008): only apps/web may."
                  },
                  {
                    "group": [
                      "@omnitech/interview-web",
                      "@omnitech/interview-web/*",
                      "**/apps/web",
                      "**/apps/web/**"
                    ],
                    "message": "A product never imports apps/web (AGENTS.md rule 3, INV-0007): the shell composes products, never the reverse."
                  },
                  {
                    "group": [
                      "**/ui/button",
                      "**/ui/join",
                      "**/ui/ui.css",
                      "**/ui/tokens.css",
                      "**/panels/screen-picker",
                      "**/panels/screen-picker.css",
                      "**/panels/follow-latest"
                    ],
                    "message": "Retired UI module (scripts/ui-migration-audit.ts, retiredUi.modules): use @oc-tech/omni-ui-components."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["scripts/benchmark-document-groups.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "off"
          }
        }
      }
    },
    {
      "includes": [
        "products/interview/src/backend/assistant/workspace-fixture.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "e2e/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "warn",
            "noArrayIndexKey": "warn"
          },
          "correctness": {
            "useYield": "warn",
            "noEmptyPattern": "warn"
          },
          "a11y": {
            "useSemanticElements": "warn",
            "useAriaPropsSupportedByRole": "warn",
            "useFocusableInteractive": "warn",
            "noStaticElementInteractions": "warn",
            "useKeyWithClickEvents": "warn",
            "noNoninteractiveTabindex": "warn",
            "useAriaPropsForRole": "warn",
            "noAriaHiddenOnFocusable": "warn",
            "noRedundantRoles": "warn",
            "noNoninteractiveElementToInteractiveRole": "warn",
            "useMediaCaption": "warn"
          }
        }
      }
    }
  ]
}
