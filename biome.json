{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "includes": [
      "**/*.{js,jsx,ts,tsx,json,jsonc}",
      "!**/node_modules",
      "!**/.next",
      "!**/.data",
      "!.assistant-local",
      "!.dev-local",
      "!**/dist",
      "!**/.turbo",
      "!coverage",
      "!packages/database/drizzle",
      "!rulesync.jsonc",
      "!opencode.jsonc"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false
    }
  }
}
