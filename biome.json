{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "includes": [
      "**/*.{js,jsx,ts,tsx,json,jsonc}",
      "!**/node_modules",
      "!**/.next",
      "!**/.next-e2e*",
      "!**/.playwright-report",
      "!**/.test-results",
      "!apps/web/public/ocr",
      "!.swiftlint.baseline.json",
      "!e2e/live-session/.stack",
      "!e2e/live-session/.audit",
      "!**/.data",
      "!.dev-local",
      "!**/dist",
      "!**/.turbo",
      "!**/.build",
      "!**/.build-cov",
      "!coverage",
      "!packages/database/drizzle",
      "!bionic",
      "!.claude/worktrees"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUndeclaredDependencies": "error",
        "noPrivateImports": "error",
        "useYield": "error",
        "noUnsafeOptionalChaining": "error",
        "noEmptyPattern": "warn",
        "noEmptyCharacterClassInRegex": "warn",
        "noUnusedVariables": "warn",
        "noUnusedFunctionParameters": "warn"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["next", "next/*"],
                "message": "Domain code never imports Next.js (AGENTS.md rule 3, INV-0008): only apps/web may."
              }
            ]
          }
        },
        "noNonNullAssertion": "off",
        "useImportType": "warn",
        "useTemplate": "warn",
        "useConst": "warn"
      },
      "a11y": {
        "useSemanticElements": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "useFocusableInteractive": "warn",
        "noStaticElementInteractions": "warn",
        "useKeyWithClickEvents": "warn",
        "noNoninteractiveTabindex": "warn",
        "useAriaPropsForRole": "warn",
        "noAriaHiddenOnFocusable": "warn",
        "noRedundantRoles": "warn",
        "noNoninteractiveElementToInteractiveRole": "warn",
        "useMediaCaption": "warn"
      },
      "suspicious": {
        "noAssignInExpressions": "warn",
        "useIterableCallbackReturn": "warn",
        "noShadowRestrictedNames": "warn",
        "noImplicitAnyLet": "warn",
        "noExportsInTest": "warn",
        "noExplicitAny": "warn",
        "noUndeclaredEnvVars": "warn",
        "noConfusingVoidType": "warn",
        "noTemplateCurlyInString": "warn",
        "noUselessEscapeInString": "warn",
        "noControlCharactersInRegex": "error",
        "noArrayIndexKey": "warn"
      },
      "complexity": {
        "useOptionalChain": "warn",
        "noCommaOperator": "warn",
        "useRegexLiterals": "warn",
        "noBannedTypes": "warn",
        "noUselessEscapeInRegex": "warn",
        "noUselessFragments": "warn",
        "useLiteralKeys": "off"
      },
      "performance": {
        "noAccumulatingSpread": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["products/*/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["next", "next/*"],
                    "message": "Domain code never imports Next.js (AGENTS.md rule 3, INV-0008): only apps/web may."
                  },
                  {
                    "group": [
                      "@omnitech/interview-web",
                      "@omnitech/interview-web/*",
                      "**/apps/web",
                      "**/apps/web/**"
                    ],
                    "message": "A product never imports apps/web (AGENTS.md rule 3, INV-0007): the shell composes products, never the reverse."
                  },
                  {
                    "group": [
                      "**/ui/button",
                      "**/ui/join",
                      "**/ui/ui.css",
                      "**/ui/tokens.css",
                      "**/panels/screen-picker",
                      "**/panels/screen-picker.css",
                      "**/panels/follow-latest"
                    ],
                    "message": "Retired UI module (scripts/ui-migration-audit.ts, retiredUi.modules): use @oc-tech/omni-ui-components."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["scripts/benchmark-document-groups.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "off"
          }
        }
      }
    },
    {
      "includes": [
        "products/interview/src/backend/assistant/workspace-fixture.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "e2e/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "warn",
            "noArrayIndexKey": "warn"
          },
          "correctness": {
            "useYield": "warn",
            "noEmptyPattern": "warn"
          },
          "a11y": {
            "useSemanticElements": "warn",
            "useAriaPropsSupportedByRole": "warn",
            "useFocusableInteractive": "warn",
            "noStaticElementInteractions": "warn",
            "useKeyWithClickEvents": "warn",
            "noNoninteractiveTabindex": "warn",
            "useAriaPropsForRole": "warn",
            "noAriaHiddenOnFocusable": "warn",
            "noRedundantRoles": "warn",
            "noNoninteractiveElementToInteractiveRole": "warn",
            "useMediaCaption": "warn"
          }
        }
      }
    }
  ]
}
